# DisguiseBrowser with the Camoufox engine.
#
# The image does not compile Firefox. With no build args it downloads the
# official Camoufox binary (no canvas patch). A patched build is an archive
# of the camoufox-dist directory, camoufox-bin at the archive root:
#
#   tar -C camoufox-dist -I zstd -cf camoufox-dist.tar.zst .
#   docker build -f Dockerfile.camoufox \
#     --build-arg CAMOUFOX_DIST_URL=https://host/camoufox-dist.tar.zst \
#     --build-arg CAMOUFOX_DIST_SHA256=<sha256> \
#     -t disguisebrowser-fox .
#
# Check:   docker run --rm disguisebrowser-fox doctor --engine camoufox
# Profile: docker run --rm -v fox-data:/data disguisebrowser-fox profile create shop-1 --os windows
# Score:   docker run --rm --shm-size=1g -v fox-data:/data disguisebrowser-fox \
#              test --engine camoufox --profile shop-1 --display virtual
#
# Profiles (identity, cookies, storage) live in /data, keep it on a volume.
# Camoufox starts its own Xvfb for display=virtual; no window manager is needed.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    HOME=/home/disguise \
    DISGUISE_HOME=/data \
    PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        locales \
        python3 \
        python3-venv \
        xz-utils \
        zstd \
        xvfb \
        xauth \
        libgtk-3-0t64 \
        libx11-xcb1 \
        libxt6t64 \
        libxtst6 \
        libasound2t64 \
        libdbus-glib-1-2 \
        libgl1-mesa-dri \
        mesa-utils \
        fonts-liberation \
        fonts-dejavu-core \
        fonts-noto-core \
        fonts-noto-color-emoji \
        fonts-noto-cjk \
        fonts-unifont \
    && sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

RUN python3 -m venv /opt/venv
WORKDIR /opt/disguisebrowser
COPY pyproject.toml README.md ./
COPY src ./src
RUN /opt/venv/bin/pip install --no-cache-dir ".[camoufox,mcp]"

COPY docker/camoufox-entrypoint.sh /usr/local/bin/disguise-entry
RUN chmod 755 /usr/local/bin/disguise-entry \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin disguise \
    && mkdir -p /data

# Empty URL: official Camoufox via `camoufox fetch`.
# Set URL: a zstd archive of the patched build, sha256 required.
ARG CAMOUFOX_DIST_URL=
ARG CAMOUFOX_DIST_SHA256=
RUN set -eu; \
    if [ -n "$CAMOUFOX_DIST_URL" ]; then \
        if [ -z "$CAMOUFOX_DIST_SHA256" ]; then \
            echo "CAMOUFOX_DIST_SHA256 is required when CAMOUFOX_DIST_URL is set" >&2; \
            exit 1; \
        fi; \
        curl -fL --retry 3 -o /tmp/camoufox-dist.tar.zst "$CAMOUFOX_DIST_URL"; \
        echo "$CAMOUFOX_DIST_SHA256  /tmp/camoufox-dist.tar.zst" | sha256sum -c -; \
        mkdir -p /opt/camoufox; \
        tar -I zstd -xf /tmp/camoufox-dist.tar.zst -C /opt/camoufox; \
        test -x /opt/camoufox/camoufox-bin; \
        curl -fL --retry 3 -o /tmp/fonts-bundle-v1.tar.xz \
            https://github.com/daijro/camoufox/releases/download/font-bundle-v1/fonts-bundle-v1.tar.xz; \
        echo "8f345ce22a475c45eb9974d3e739fe1a2f5a742882c58727dbc55ab69cae8953  /tmp/fonts-bundle-v1.tar.xz" | sha256sum -c -; \
        tar -xJf /tmp/fonts-bundle-v1.tar.xz -C /opt/camoufox; \
        test -f /opt/camoufox/fonts/groups.json; \
        rm -f /tmp/camoufox-dist.tar.zst /tmp/fonts-bundle-v1.tar.xz; \
    else \
        python -m camoufox fetch; \
    fi

# GeoIP database and the fpgen model. The browser itself was fetched above.
RUN python -c "from camoufox.addons import DefaultAddons, maybe_download_addons; from camoufox.fpgen_model import ensure_fpgen_model; from camoufox.geolocation import ALLOW_GEOIP, download_mmdb; maybe_download_addons(list(DefaultAddons)); ensure_fpgen_model(); download_mmdb() if ALLOW_GEOIP else None" \
    && python -c "from camoufox.fingerprints import generate_fingerprint; generate_fingerprint(os='windows')" \
    && chown -R disguise:disguise /home/disguise /data \
    && if [ -d /opt/camoufox ]; then chown -R disguise:disguise /opt/camoufox; fi \
    && chown -R disguise:disguise "$(python -c 'import fpgen, pathlib; print(pathlib.Path(fpgen.__file__).parent)')"

USER disguise
WORKDIR /home/disguise

VOLUME ["/data"]
ENTRYPOINT ["disguise-entry"]
CMD ["doctor", "--engine", "camoufox"]
