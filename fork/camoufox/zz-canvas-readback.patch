+// Profile noise for WebGL readback. Only tightly packed RGBA/BGRA bytes:
+// a row stride would make the pixel grid wrong. Same function as canvas 2D.
+void NoiseWebGLReadback(uint8_t* bytes, size_t availBytes, int32_t width,
+                        int32_t height, GLenum format, GLenum type,
+                        const webgl::PixelPackingState& pack) {
+  if (!bytes || type != LOCAL_GL_UNSIGNED_BYTE || width <= 0 || height <= 0) {
+    return;
+  }
+  dom::CanvasFingerprintManager::ByteOrder order;
+  if (format == LOCAL_GL_RGBA) {
+    order = dom::CanvasFingerprintManager::ByteOrder::RGBA;
+  } else if (format == LOCAL_GL_BGRA) {
+    order = dom::CanvasFingerprintManager::ByteOrder::BGRA;
+  } else {
+    return;
+  }
+  if (pack.skipPixels || pack.skipRows || pack.skipImages) {
+    return;
+  }
+  if (pack.rowLength != 0 && pack.rowLength != static_cast<uint32_t>(width)) {
+    return;
+  }
+  const uint32_t rowBytes = static_cast<uint32_t>(width) * 4u;
+  if (pack.alignmentInTypeElems == 0 ||
+      rowBytes % pack.alignmentInTypeElems != 0) {
+    return;
+  }
+  const size_t nbytes =
+      static_cast<size_t>(rowBytes) * static_cast<size_t>(height);
+  if (availBytes < nbytes) {
+    return;
+  }
+  const uint32_t seed = dom::CanvasFingerprintManager::Seed();
+  if (seed == 0) {
+    return;
+  }
+  dom::CanvasFingerprintManager::ApplyNoise(bytes, nbytes, seed, order);
+}
